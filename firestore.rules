rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function authorizedUser() {
      return request.auth != null
        && exists(/databases/$(database)/documents/usuarios_autorizados/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios_autorizados/$(request.auth.uid)).data.activo == true;
    }

    match /usuarios_autorizados/{uid} {
      allow read, write: if false;
    }

    match /empleados/{empleadoId} {
      allow read, create, update: if authorizedUser();
      allow delete: if false;
    }

    match /bancos_horas/{empleadoId} {
      allow read, create, update: if authorizedUser();
      allow delete: if false;
    }

    match /movimientos_banco_horas/{movimientoId} {
      allow read, create: if authorizedUser();
      allow update, delete: if false;
    }

    match /asistencia/{registroId} {
      allow read, create: if authorizedUser();
      allow update, delete: if false;
    }
  }
}
