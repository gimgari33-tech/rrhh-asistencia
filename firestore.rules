rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function authorizationPath() {
      return /databases/$(database)/documents/usuarios_autorizados/$(request.auth.uid);
    }

    function authorizedUser() {
      return request.auth != null
        && exists(authorizationPath())
        && get(authorizationPath()).data.activo == true;
    }

    function superAdmin() {
      return authorizedUser() && get(authorizationPath()).data.rol == 'SUPERADMIN';
    }

    match /usuarios_autorizados/{uid} {
      allow read, write: if false;
    }

    match /empleados/{empleadoId} {
      allow read: if authorizedUser();
      allow create, update: if superAdmin();
      allow delete: if false;
    }

    match /bancos_horas/{empleadoId} {
      allow read: if authorizedUser();
      allow create, update: if superAdmin();
      allow delete: if false;
    }

    match /movimientos_banco_horas/{movimientoId} {
      allow read: if authorizedUser();
      allow create: if superAdmin();
      allow update, delete: if false;
    }

    match /asistencia/{registroId} {
      allow read: if authorizedUser();
      allow create: if superAdmin();
      allow update, delete: if false;
    }
  }
}
